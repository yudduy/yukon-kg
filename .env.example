OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.4
# Optional exact provider route for reproducible confirmatory runs.
OPENROUTER_PROVIDER=OpenAI
OPENROUTER_INPUT_USD_PER_MILLION=2.5
OPENROUTER_OUTPUT_USD_PER_MILLION=15
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=yukon-kg
GITHUB_TOKEN=

# Adaptive Dungeness campaign hard limits.
DUNGENESS_PROTOCOL_SEED=dungeness-adaptive-v1
DUNGENESS_LEDGER_PRIVATE_KEY_PATH=/cursor/stores/self/yukon-kg/dungeness-ledger-ed25519.pem
DUNGENESS_CALIBRATION_SPEND_CAP_USD=
DUNGENESS_CONFIRMATORY_SPEND_CAP_USD=
DUNGENESS_PRIME_SPEND_CAP_USD=
DUNGENESS_CAMPAIGN_TURNS=24
DUNGENESS_CAMPAIGN_ROOT_TOKENS=120000
DUNGENESS_CAMPAIGN_EVALUATOR_CALLS=32
DUNGENESS_CAMPAIGN_WALL_MS=3600000
DUNGENESS_CAMPAIGN_COST_USD=25
