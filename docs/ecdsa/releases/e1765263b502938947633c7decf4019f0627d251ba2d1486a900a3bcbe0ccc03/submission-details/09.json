{"excerpts":["+fn borrowed_const_fold_carries(\n+    b: &mut B,\n+    need: usize,\n+    borrowed: &[QubitId],\n+) -> (Vec<QubitId>, Vec<QubitId>) {\n+    let borrowed_len = borrowed.len().min(need);\n+    let owned = b.alloc_qubits(need - borrowed_len);\n+    let mut carries = Vec::with_capacity(need);\n+    carries.extend_from_slice(&borrowed[..borrowed_len]);\n+    carries.extend_from_slice(&owned);\n+    (carries, owned)\n+}","-    set_default_env(\"DIALOG_GCD_FOLD_CARRY_TRUNC_W\", \"19\");\n-    set_default_env(\"DIALOG_TAIL_NONCE\", \"17761178\");\n+    set_default_env(\"DIALOG_GCD_FOLD_CARRY_TRUNC_W\", \"18\");\n+    set_default_env(\"DIALOG_TAIL_NONCE\", \"9300018914153\");","-    set_default_env(\"DIALOG_GCD_APPLY_CHUNKED_F_BLOCKS\", \"12\");\n+    set_default_env(\"DIALOG_GCD_APPLY_CHUNKED_F_BLOCKS\", \"16\");","-    set_default_env(\"SQUARE_ROW_MAX_SEG\", \"188\");\n+    set_default_env(\"SQUARE_ROW_MAX_SEG\", \"186\");\n+    set_default_env(\"DIALOG_GCD_SPECIAL_FOLD_BORROW_CARRIES\", \"1\");"],"schema":"yukon.atlas","schemaVersion":3,"shard":"09","submissions":[{"evidence":[],"note":"# T-squeeze-4: 3D Island Search (R × K0 × W)","submissionId":"09a41fb5-1d7d-466a-864b-621e650433d8"},{"evidence":[],"note":null,"submissionId":"0993e768-99b9-4912-ba33-1ac14c3aa7b5"},{"evidence":[{"changeId":"09daa103-2773-4391-b135-837a8bb77a12::m1","excerptIndex":0},{"changeId":"09daa103-2773-4391-b135-837a8bb77a12::m2","excerptIndex":1},{"changeId":"09daa103-2773-4391-b135-837a8bb77a12::m3","excerptIndex":2},{"changeId":"09daa103-2773-4391-b135-837a8bb77a12::m4","excerptIndex":3},{"changeId":"09daa103-2773-4391-b135-837a8bb77a12::m5","excerptIndex":1}],"note":null,"submissionId":"09daa103-2773-4391-b135-837a8bb77a12"}],"view":"submission-detail"}
